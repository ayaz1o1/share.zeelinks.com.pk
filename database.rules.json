{
  "rules": {
    "rooms": {
      "$room": {
        "peers": {
          "$peer": {
            ".read": true,
            ".write": true,
            ".validate": "newData.hasChildren(['peerId', 'updatedAt'])"
          },
          ".read": true
        },
        "signals": {
          "$peer": {
            ".read": true,
            ".write": true
          }
        }
      }
    }
  }
}
